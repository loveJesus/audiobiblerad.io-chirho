{
	"name": "audiobiblerad.io-chirho",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"env:local": "bun scripts-chirho/ensure_local_worker_bindings_chirho.ts",
		"dev": "bun run env:local && vite dev",
		"build": "bun run env:local && bun run gen:check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --env-file ./wrangler-bindings-chirho.env",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run gen:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "bun scripts-chirho/generate_worker_types_chirho.ts",
		"gen:check": "bun scripts-chirho/generate_worker_types_chirho.ts --check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-cloudflare": "7.2.10",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "24.19.2",
		"@vitest/browser-playwright": "4.1.12",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "4.1.12",
		"vitest-browser-svelte": "2.2.1",
		"wrangler": "4.162.0"
	}
}
